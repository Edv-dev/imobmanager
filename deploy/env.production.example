# ImobManager --- configuração de produção
# Copie para /opt/imobmanager/.env, preencha os valores e aplique chmod 600.

NODE_ENV=production
PORT=3000
HOST=127.0.0.1
APP_URL=https://imobmanager.example.com
TRUST_PROXY=1

# Gere com:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
SESSION_TTL_MINUTES=480
SESSION_REMEMBER_DAYS=7
AUTH_MAX_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=imobmanager
DB_USER=imobmanager
DB_PASSWORD=
DB_SSL=false
DB_POOL_MAX=10
# DATABASE_URL=postgresql://imobmanager:senha@127.0.0.1:5432/imobmanager

UPLOAD_DIR=/var/lib/imobmanager/uploads
UPLOAD_MAX_IMAGE_BYTES=5242880
UPLOAD_MAX_IMAGES_PER_PROPERTY=10

# Obrigatório para recuperação de senha por e-mail em produção.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Usados pelos scripts de backup (systemd define os mesmos valores).
BACKUP_DIR=/var/backups/imobmanager
BACKUP_RETENTION_DAYS=30
