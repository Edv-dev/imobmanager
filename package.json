{
  "name": "imobmanager",
  "version": "0.1.0",
  "description": "Sistema web de gestão para uma única imobiliária",
  "private": true,
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/*.test.js",
    "test:watch": "node --test --watch tests/*.test.js",
    "db:ping": "node scripts/db-ping.js",
    "db:setup": "bash scripts/setup-database.sh",
    "db:check": "node scripts/db-integrity-check.js",
    "migrate:up": "node scripts/migrate.js up",
    "migrate:down": "node scripts/migrate.js down",
    "migrate:status": "node scripts/migrate.js status"
  },
  "keywords": [
    "imobiliaria",
    "gestao",
    "express",
    "postgresql"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  }
}
