{
  "name": "imobmanager",
  "version": "0.1.0",
  "description": "Sistema web de gestão para uma única imobiliária",
  "private": true,
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:watch": "node --test --test-concurrency=1 --watch tests/*.test.js",
    "db:ping": "node scripts/db-ping.js",
    "db:setup": "bash scripts/setup-database.sh",
    "db:check": "node scripts/db-integrity-check.js",
    "migrate:up": "node scripts/migrate.js up",
    "migrate:down": "node scripts/migrate.js down",
    "migrate:status": "node scripts/migrate.js status",
    "admin:create": "node scripts/create-admin.js",
    "audit:purge": "node scripts/purge-audit.js"
  },
  "keywords": [
    "imobiliaria",
    "gestao",
    "express",
    "postgresql"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1"
  }
}
