# ImobManager --- configuração de ambiente
# Copie este arquivo para .env e ajuste os valores.

# Servidor
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_URL=http://localhost:3000

# Segurança da sessão (obrigatório em produção, mínimo de 32 caracteres)
# Gere com: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
SESSION_TTL_MINUTES=480
SESSION_REMEMBER_DAYS=7
AUTH_MAX_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30

# Banco de dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=imobmanager
DB_USER=imobmanager
DB_PASSWORD=
DB_SSL=false
DB_POOL_MAX=10

# Opcional: substitui as variáveis DB_* por uma URL de conexão completa.
# Exemplo: postgresql://imobmanager:senha@localhost:5432/imobmanager
# DATABASE_URL=

# E-mail (opcional; necessário para recuperação de senha em produção)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
