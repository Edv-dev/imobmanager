# ImobManager --- configuração de ambiente
# Copie este arquivo para .env e ajuste os valores.

# Servidor
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Banco de dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=imobmanager
DB_USER=imobmanager
DB_PASSWORD=
DB_SSL=false
DB_POOL_MAX=10

# Opcional: substitui as variáveis DB_* por uma URL de conexão completa.
# Exemplo: postgresql://imobmanager:senha@localhost:5432/imobmanager
# DATABASE_URL=
